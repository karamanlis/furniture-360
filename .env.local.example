# AI Furniture 360 Visualizer — Environment Variables

# Image Generation Provider
# Valid values: openai | pollinations | mock (default: mock)
IMAGE_GENERATION_PROVIDER=mock

# Pollinations — free, no API key required.
# Use reference-image conditioning (img2img) so the same product stays identical
# across all 24 angles. No signup needed; registering at auth.pollinations.ai
# raises the rate limit (1 req/15s anonymous → 1 req/5s) and removes watermarks.
# POLLINATIONS_MODEL=flux
# POLLINATIONS_SEED=<fixed base seed, optional>

# OpenAI (required when IMAGE_GENERATION_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# Optional: override the model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
# Vision model for Identity QC (default: gpt-4o)
# OPENAI_VISION_MODEL=gpt-4o

# Concurrency (default: 3)
# Pollinations anonymous tier is ~1 request/15s per IP — keep this at 1.
# GENERATION_CONCURRENCY=1

# Max upload size in MB (default: 10)
# UPLOAD_MAX_MB=10